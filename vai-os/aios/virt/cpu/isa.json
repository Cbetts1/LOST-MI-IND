    {"op": "DIV",  "code": 5,  "args": 3, "desc": "Divide registers"},
    {"op": "AND",  "code": 6,  "args": 3, "desc": "Bitwise AND"},
    {"op": "OR",   "code": 7,  "args": 3, "desc": "Bitwise OR"},
    {"op": "XOR",  "code": 8,  "args": 3, "desc": "Bitwise XOR"},
    {"op": "NOT",  "code": 9,  "args": 2, "desc": "Bitwise NOT"},
