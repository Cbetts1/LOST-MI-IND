    {"op": "POP",  "code": 21, "args": 1, "desc": "Pop stack to register"},
    {"op": "CALL", "code": 22, "args": 1, "desc": "Call subroutine"},
    {"op": "RET",  "code": 23, "args": 0, "desc": "Return from subroutine"},
